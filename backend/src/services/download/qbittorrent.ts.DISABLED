import { prisma } from '../../db/prisma';

export interface QBittorrentConfig {
  host: string;
  port: number;
  username: string;
  password: string;
}

export interface TorrentInfo {
  hash: string;
  name: string;
  size: number;
  progress: number; // 0-1
  dlspeed: number; // bytes/s
  eta: number; // seconds
  state: string;
  save_path: string;
}

/**
 * qBittorrent Web API client
 */
export class QBittorrentClient {
  private config: QBittorrentConfig;
  private cookie: string | null = null;
  private baseUrl: string;

  constructor(config: QBittorrentConfig) {
    this.config = config;
    this.baseUrl = `http://${config.host}:${config.port}`;
  }

  /**
   * Login to qBittorrent
   */
  async login(): Promise<boolean> {
    try {
      const response = await fetch(`${this.baseUrl}/api/v2/auth/login`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: new URLSearchParams({
          username: this.config.username,
          password: this.config.password,
        }),
      });

      if (response.ok) {
        const cookie = response.headers.get('set-cookie');
        if (cookie) {
          this.cookie = cookie.split(';')[0];
          return true;
        }
      }
      return false;
    } catch (error) {
      console.error('qBittorrent login error:', error);
      return false;
    }
  }

  /**
   * Add torrent by magnet URL
   */
  async addMagnet(magnetUrl: string, savePath?: string): Promise<boolean> {
    if (!this.cookie && !(await this.login())) {
      throw new Error('Failed to login to qBittorrent');
    }

    try {
      const params = new URLSearchParams({
        urls: magnetUrl,
      });

      if (savePath) {
        params.append('savepath', savePath);
      }

      const response = await fetch(`${this.baseUrl}/api/v2/torrents/add`, {
        method: 'POST',
        headers: {
          'Cookie': this.cookie!,
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: params,
      });

      return response.ok;
    } catch (error) {
      console.error('Add magnet error:', error);
      return false;
    }
  }

  /**
   * Get all torrents
   */
  async getTorrents(): Promise<TorrentInfo[]> {
    if (!this.cookie && !(await this.login())) {
      throw new Error('Failed to login to qBittorrent');
    }

    try {
      const response = await fetch(`${this.baseUrl}/api/v2/torrents/info`, {
        headers: {
          'Cookie': this.cookie!,
        },
      });

      if (response.ok) {
        return (await response.json()) as TorrentInfo[];
      }
      return [];
    } catch (error) {
      console.error('Get torrents error:', error);
      return [];
    }
  }

  /**
   * Get torrent by hash
   */
  async getTorrent(hash: string): Promise<TorrentInfo | null> {
    const torrents = await this.getTorrents();
    return torrents.find(t => t.hash.toLowerCase() === hash.toLowerCase()) || null;
  }

  /**
   * Pause torrent
   */
  async pauseTorrent(hash: string): Promise<boolean> {
    if (!this.cookie && !(await this.login())) {
      throw new Error('Failed to login to qBittorrent');
    }

    try {
      const response = await fetch(`${this.baseUrl}/api/v2/torrents/pause`, {
        method: 'POST',
        headers: {
          'Cookie': this.cookie!,
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: new URLSearchParams({
          hashes: hash,
        }),
      });

      return response.ok;
    } catch (error) {
      console.error('Pause torrent error:', error);
      return false;
    }
  }

  /**
   * Resume torrent
   */
  async resumeTorrent(hash: string): Promise<boolean> {
    if (!this.cookie && !(await this.login())) {
      throw new Error('Failed to login to qBittorrent');
    }

    try {
      const response = await fetch(`${this.baseUrl}/api/v2/torrents/resume`, {
        method: 'POST',
        headers: {
          'Cookie': this.cookie!,
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: new URLSearchParams({
          hashes: hash,
        }),
      });

      return response.ok;
    } catch (error) {
      console.error('Resume torrent error:', error);
      return false;
    }
  }

  /**
   * Delete torrent
   */
  async deleteTorrent(hash: string, deleteFiles: boolean = false): Promise<boolean> {
    if (!this.cookie && !(await this.login())) {
      throw new Error('Failed to login to qBittorrent');
    }

    try {
      const response = await fetch(`${this.baseUrl}/api/v2/torrents/delete`, {
        method: 'POST',
        headers: {
          'Cookie': this.cookie!,
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: new URLSearchParams({
          hashes: hash,
          deleteFiles: deleteFiles.toString(),
        }),
      });

      return response.ok;
    } catch (error) {
      console.error('Delete torrent error:', error);
      return false;
    }
  }

  /**
   * Test connection
   */
  async test(): Promise<boolean> {
    return await this.login();
  }
}

// Singleton instance
let qbClient: QBittorrentClient | null = null;

/**
 * Get qBittorrent client instance
 */
export function getQBittorrentClient(): QBittorrentClient {
  if (!qbClient) {
    const config: QBittorrentConfig = {
      host: process.env.QBITTORRENT_HOST || 'localhost',
      port: parseInt(process.env.QBITTORRENT_PORT || '8080'),
      username: process.env.QBITTORRENT_USERNAME || 'admin',
      password: process.env.QBITTORRENT_PASSWORD || 'adminadmin',
    };
    qbClient = new QBittorrentClient(config);
  }
  return qbClient;
}

/**
 * Sync downloads from qBittorrent to database
 */
export async function syncDownloads() {
  const client = getQBittorrentClient();
  const torrents = await client.getTorrents();

  for (const torrent of torrents) {
    const existing = await prisma.download.findFirst({
      where: (downloads, { eq }) => eq(downloads.torrentHash, torrent.hash),
    });
    
    if (existing) {
      // Update progress
      await prisma.download.updateMany(
        .set({
          progress: torrent.progress,
          downloadSpeed: torrent.dlspeed,
          eta: torrent.eta,
          status: torrent.state,
        })
        .where(eq(downloads.torrentHash, torrent.hash));
    }
  }
}
