FROM node:24-alpine

WORKDIR /app

# Install dependencies
COPY backend/package*.json ./
RUN npm ci --only=production

# Copy source code
COPY backend/tsconfig.json ./
COPY backend/src ./src

# Build TypeScript
RUN npm install -D typescript tsx
RUN npx tsc

# Create data directory
RUN mkdir -p /data

EXPOSE 3001

CMD ["node", "dist/index.js"]
